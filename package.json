{
  "name": "career-ops-dashboard",
  "version": "0.1.0",
  "description": "Unofficial local-first dashboard for the career-ops job-search pipeline.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Alexey Leontyev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LexLeontiev/career-ops-dashboard.git"
  },
  "homepage": "https://github.com/LexLeontiev/career-ops-dashboard#readme",
  "bugs": {
    "url": "https://github.com/LexLeontiev/career-ops-dashboard/issues"
  },
  "keywords": [
    "career-ops",
    "job-search",
    "dashboard",
    "local-first",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch src/server/start.ts\"",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx src/server/start.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "express": "^4.19.2",
    "highlight.js": "^11.12.0",
    "material-symbols": "^0.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
