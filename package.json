{
  "name": "career-ops-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts test/**/*.test.tsx src/**/*.test.tsx"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
